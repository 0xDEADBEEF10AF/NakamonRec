# 本番リリース署名用の機密情報テンプレート。
#
# 使い方:
#   1. このファイルを app/keystore.properties としてコピーする
#   2. 下記 YOUR_xxx を実際の値で書き換える
#   3. app/keystore.properties は .gitignore で除外されるためコミットされない
#
# 各マシン (Mac / Windows) で個別に設定する必要があります。
# release.keystore 本体も *.keystore で gitignore されているため、
# 安全な手段 (USB / 暗号化チャット等) で各マシンに配布してください。

storeFile=release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=key0
keyPassword=YOUR_KEY_PASSWORD
