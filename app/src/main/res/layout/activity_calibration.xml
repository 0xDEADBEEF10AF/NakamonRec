<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.dqw.nakamonrec.CalibrationView
        android:id="@+id/calibrationView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- テンプレート名表示 -->
    <TextView
        android:id="@+id/textTemplateName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Template: ---"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 進捗表示用のレイアウト -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#AA000000"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/msg_analyzing"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 操作パネル -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC222222"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/textInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibrate_guide_default"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- iOS 版に合わせて全ボタンを横一列に配置。
             btnAutoDetail は vs モードのみ VISIBLE (CalibrationActivity で制御)。
             GONE 時は残りボタンが weight で再配分され隙間なく詰まる。
             narrow 端末でも 1 行に収まるよう 0dp+weight / maxLines=1 / 小さめ textSize。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 自動校正 -->
            <Button
                android:id="@+id/btnAuto"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:maxLines="1"
                android:text="@string/btn_auto"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:backgroundTint="#F09199" />

            <!-- デフォルト -->
            <Button
                android:id="@+id/btnDefault"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:maxLines="1"
                android:text="@string/btn_default"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#444444" />

            <!-- 詳細校正 (vs モードのみ表示) -->
            <Button
                android:id="@+id/btnAutoDetail"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:maxLines="1"
                android:text="@string/btn_auto_detail"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:backgroundTint="#F09199" />

            <!-- 戻る -->
            <Button
                android:id="@+id/btnCancel"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:maxLines="1"
                android:text="@string/btn_back"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#444444" />

            <!-- この位置で決定 -->
            <Button
                android:id="@+id/btnSave"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:maxLines="1"
                android:text="@string/btn_save_calibration"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:backgroundTint="#F09199" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>