<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222">

    <!-- 上部：総合戦績 と グラフ の横並びエリア -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_header_height"
        android:layout_marginTop="48dp"
        android:layout_marginHorizontal="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 左側：総合戦績カード -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTotal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#333333"
            app:strokeWidth="0dp"
            app:strokeColor="#AAAAAA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/textTotalLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_total_win_rate"
                    android:textColor="#AAAAAA"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:gravity="center"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeStepGranularity="1sp"
                    tools:textSize="14sp"/>

                <TextView
                    android:id="@+id/valTotalRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F09199"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:text="@string/status_none"/>

                <TextView
                    android:id="@+id/valTotalCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:text="@string/status_none"/>

                <TextView
                    android:id="@+id/valTotalWinLose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/status_none"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 右側：トレンドグラフカード -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGraph"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_margin="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#333333"
            app:strokeWidth="0dp"
            app:strokeColor="#AAAAAA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/label_recent_trend"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"/>

                <com.dqw.nakamonrec.WinRateGraphView
                    android:id="@+id/winRateGraph"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- パーティ別戦績エリア -->
    <LinearLayout
        android:id="@+id/layoutParties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardP1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#333333"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:strokeColor="#AAAAAA">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_p1" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginVertical="4dp">
                    <ImageView android:id="@+id/imgP1M1" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p1" />
                    <ImageView android:id="@+id/imgP1M2" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p1" />
                    <ImageView android:id="@+id/imgP1M3" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p1" />
                    <ImageView android:id="@+id/imgP1M4" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p1" />
                </LinearLayout>
                <TextView android:id="@+id/valP1Rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F09199" android:textSize="@dimen/party_summary_text_rate" android:textStyle="bold" android:text="@string/status_none"/>
                <TextView android:id="@+id/valP1Usage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAAAAA" android:textSize="11sp" android:text="@string/status_none"/>
                <TextView android:id="@+id/valP1WinLoseShort" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:text="@string/status_none" android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardP2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#333333"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:strokeColor="#AAAAAA">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_p2" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginVertical="4dp">
                    <ImageView android:id="@+id/imgP2M1" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p2" />
                    <ImageView android:id="@+id/imgP2M2" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p2" />
                    <ImageView android:id="@+id/imgP2M3" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p2" />
                    <ImageView android:id="@+id/imgP2M4" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p2" />
                </LinearLayout>
                <TextView android:id="@+id/valP2Rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F09199" android:textSize="@dimen/party_summary_text_rate" android:textStyle="bold" android:text="@string/status_none"/>
                <TextView android:id="@+id/valP2Usage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAAAAA" android:textSize="11sp" android:text="@string/status_none"/>
                <TextView android:id="@+id/valP2WinLoseShort" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:text="@string/status_none" android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardP3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="#333333"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:strokeColor="#AAAAAA">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_p3" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginVertical="4dp">
                    <ImageView android:id="@+id/imgP3M1" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p3" />
                    <ImageView android:id="@+id/imgP3M2" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p3" />
                    <ImageView android:id="@+id/imgP3M3" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p3" />
                    <ImageView android:id="@+id/imgP3M4" android:layout_width="@dimen/party_summary_icon_size" android:layout_height="@dimen/party_summary_icon_size" android:layout_margin="1dp" android:scaleType="centerCrop" android:contentDescription="@string/label_p3" />
                </LinearLayout>
                <TextView android:id="@+id/valP3Rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F09199" android:textSize="@dimen/party_summary_text_rate" android:textStyle="bold" android:text="@string/status_none"/>
                <TextView android:id="@+id/valP3Usage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAAAAA" android:textSize="11sp" android:text="@string/status_none"/>
                <TextView android:id="@+id/valP3WinLoseShort" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:text="@string/status_none" android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- フィルタステータスバー -->
    <LinearLayout
        android:id="@+id/layoutFilterStatus"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="0dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="0dp"
        android:background="@drawable/bg_filter_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutParties"
        tools:visibility="visible">

        <!-- ChipGroupをスクロール可能にするか、横並びにするために調整 -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/chipGroupFilters"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_clear_filter"
            android:textColor="#90D7EC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/layoutFilterStatus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- 下部ボタンエリア -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/ic_menu_revert"
        app:maxImageSize="32dp"
        app:tint="#FFFFFF"
        app:backgroundTint="#333333"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:elevation="8dp"
        android:contentDescription="@string/btn_back" />

    <!-- モード切替ボタン (Edit / Filter) 円形アイコンのみに変更 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModeToggle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:padding="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        app:backgroundTint="#333333"
        app:cornerRadius="28dp"
        app:strokeWidth="2dp"
        app:strokeColor="#AAAAAA"
        app:icon="@android:drawable/ic_menu_sort_by_size"
        app:iconSize="28dp"
        app:iconTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:elevation="8dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAnalyze"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/ic_menu_search"
        app:maxImageSize="32dp"
        app:tint="#FFFFFF"
        app:backgroundTint="#333333"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:elevation="8dp"
        android:contentDescription="@string/btn_analyze" />

</androidx.constraintlayout.widget.ConstraintLayout>