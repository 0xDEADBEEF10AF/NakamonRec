<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="2dp"
    app:cardBackgroundColor="#333333">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingHorizontal="4dp"
        android:gravity="center_vertical">

        <!-- 左側: 勝敗とパーティ番号 (縦並び) -->
        <LinearLayout
            android:layout_width="@dimen/battle_history_side_width_left"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/textResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/battle_history_text_result"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/textParty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/battle_history_text_sub"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 中央: モンスター画像 (味方 vs 相手) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/layoutMyMonsters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/textVsScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#88FFFFFF"
                    android:textSize="8sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_vs"
                    android:textColor="#FFFFFF"
                    android:layout_marginHorizontal="2dp"
                    android:textSize="@dimen/battle_history_text_sub"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEnemyMonsters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 右側: 日時 (2行表示想定)。iOS 版 (BattleHistoryView: .gray / 標準ウェイト) に合わせて
             太字・白ではなく細字・グレーにする (26.10.2) -->
        <!-- 文字サイズ/表示サイズを大きくした端末で「2026.10.30」が欄幅に収まらず 1 文字ずつ折り返す崩れが
             あったため (26.11.1)、日付と時刻を明示的に 2 行にし、欄幅に収まるよう文字を自動縮小する -->
        <TextView
            android:id="@+id/textTimestamp"
            android:layout_width="@dimen/battle_history_side_width_right"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textStyle="normal"
            android:textSize="@dimen/battle_history_text_sub"
            android:textColor="#8E8E93"
            android:maxLines="2"
            android:lines="2"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="7sp"
            app:autoSizeMaxTextSize="@dimen/battle_history_text_sub"
            app:autoSizeStepGranularity="1sp"
            android:layout_marginStart="2dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>